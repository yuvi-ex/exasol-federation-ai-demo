# Copy to .env and fill in. .env is git-ignored: never commit it.

# --- Exasol SaaS (cloud.exasol.com) -------------------------------------------------
# Databases -> your database -> Connect via tools
EXASOL_HOST=xxxxxxxxxxxxxxxxxxxxxxxxxx.clusters.exasol.com
EXASOL_PORT=8563
EXASOL_USER=your_exasol_user
# Avatar -> Personal access tokens
EXASOL_PAT=exa_pat_...
# For BucketFS uploads through the SaaS API: account id (org_...) and database id
EXASOL_ACCOUNT_ID=org_...
EXASOL_DATABASE_ID=...

# --- Snowflake ----------------------------------------------------------------------
# Account identifier, e.g. ABCDEFG-XY12345 (Admin -> Accounts)
SNOWFLAKE_ACCOUNT=ABCDEFG-XY12345
SNOWFLAKE_USER=EXASOL_SVC
SNOWFLAKE_ROLE=EXASOL_READER
SNOWFLAKE_WAREHOUSE=EXASOL_DEMO_WH
# Programmatic access token for SNOWFLAKE_USER (created by setup/snowflake_setup.sql)
SNOWFLAKE_PAT=...

# --- Amazon S3 ----------------------------------------------------------------------
S3_BUCKET=your-demo-bucket
S3_REGION=eu-central-1
# READ-ONLY key for Exasol (s3:GetObject + s3:ListBucket on this bucket only)
S3_READER_ACCESS_KEY_ID=AKIA...
S3_READER_SECRET_ACCESS_KEY=...
# Uploading the Parquet files uses your normal AWS CLI login (aws s3 sync)

# --- Qdrant Cloud -------------------------------------------------------------------
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=...
QDRANT_COLLECTION=support_tickets
# A free Qdrant Cloud Inference model (384 dimensions)
QDRANT_MODEL=sentence-transformers/all-minilm-l6-v2
QDRANT_DIM=384

# --- Display ------------------------------------------------------------------------
# Shown on the page, e.g. "AWS · FRANKFURT (eu-central-1)"
REGION_LABEL=AWS · FRANKFURT (eu-central-1)
